{
  "name": "fastify-twilio-openai-voice-agent",
  "version": "1.0.0",
  "description": "Voice AI agent with Twilio, OpenAI Realtime API, ChromaDB, and MongoDB",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "fastify",
    "twilio",
    "openai",
    "voice-ai",
    "chromadb",
    "mongodb",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fastify": "5.6.1",
    "@fastify/websocket": "11.2.0",
    "@fastify/cors": "11.1.0",
    "@fastify/env": "5.0.3",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "5.2.3",
    "twilio": "5.10.4",
    "openai": "6.7.0",
    "mongodb": "6.20.0",
    "chromadb": "3.0.17",
    "ws": "8.18.3",
    "pino": "10.1.0",
    "pino-pretty": "13.1.2",
    "dotenv": "17.2.3"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.0.0"
  }
}
